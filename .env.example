# Copy to .env and generate independent secrets; never commit .env.
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SITE_URL=http://localhost:8086
# Optional SMTP contact notifications. Configure SMTP_HOST, SMTP_FROM and
# CONTACT_NOTIFICATION_TO to enable delivery; credentials depend on provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFICATION_TO=
# Required for production, after legal review:
LEGAL_NAME=
LEGAL_COUNTRY=
LEGAL_ADDRESS=
PRIVACY_EMAIL=
# Production only, lowercase, e.g. ghcr.io/your-org/yunitztech.com
IMAGE_PREFIX=
IMAGE_TAG=main
# Exact Coolify proxy IP/subnet, never 0.0.0.0/0.
TRUSTED_PROXY_CIDR=
