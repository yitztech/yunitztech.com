---
import "@fontsource-variable/manrope";
import "../styles/global.css";
import { siteUrl } from "../lib/api";

interface Props {
  lang?: string;
  title?: string;
  description?: string;
  alternate?: string;
  alternates?: Record<string, string>;
  noindex?: boolean;
  image?: string;
  article?: boolean;
}

const supportedLocales = ["es", "en", "fr", "de", "pt"] as const;
type Locale = (typeof supportedLocales)[number];

const {
  lang = "es",
  title = "YunitzTech",
  description = "",
  alternate = "/",
  alternates,
  noindex = false,
  image = "/images/business-collaboration.webp",
  article = false,
} = Astro.props;

const currentLang = (supportedLocales.includes(lang as any) ? lang : "es") as Locale;
const home = currentLang === "es" ? "/" : `/${currentLang}/`;
// Una sola forma por URL: sin barra final, salvo la portada de cada idioma (/en/), que es como la
// enlazan el menú, el hreflang y el sitemap. El gateway redirige con 301 la otra forma.
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalPath = supportedLocales.some((l) => l !== "es" && path === `/${l}`) ? `${path}/` : path;
const canonical = new URL(canonicalPath, siteUrl).href;

const defaultAlternates: Record<Locale, string> = {
  es: "/",
  en: "/en/",
  fr: "/fr/",
  de: "/de/",
  pt: "/pt/",
};

const resolvedAlternates: Record<Locale, string> = {
  ...defaultAlternates,
  ...(alternates || {}),
};

if (!alternates && alternate) {
  if (currentLang === "en") resolvedAlternates.es = alternate;
  else resolvedAlternates.en = alternate;
}

const ogLocales: Record<Locale, string> = {
  es: "es_MX",
  en: "en_US",
  fr: "fr_FR",
  de: "de_DE",
  pt: "pt_PT",
};

const langNames: Record<Locale, string> = {
  es: "Español",
  en: "English",
  fr: "Français",
  de: "Deutsch",
  pt: "Português",
};

const langAriaLabels: Record<Locale, string> = {
  es: "Cambiar idioma",
  en: "Change language",
  fr: "Changer de langue",
  de: "Sprache ändern",
  pt: "Mudar idioma",
};

const siteInLangHeader: Record<Locale, string> = {
  es: "Ver este sitio en español",
  en: "View this site in English",
  fr: "Voir ce site en français",
  de: "Diese Website auf Deutsch anzeigen",
  pt: "Ver este site em português",
};

const displayLocales: Locale[] = ["es", "en", "pt", "de", "fr"];

const skipTexts: Record<Locale, string> = {
  es: "Saltar al contenido",
  en: "Skip to content",
  fr: "Passer au contenu",
  de: "Zum Inhalt springen",
  pt: "Pular para o conteúdo",
};

const brandAria: Record<Locale, string> = {
  es: "YunitzTech inicio",
  en: "YunitzTech home",
  fr: "YunitzTech accueil",
  de: "YunitzTech Startseite",
  pt: "YunitzTech início",
};

const navAria: Record<Locale, string> = {
  es: "Navegación principal",
  en: "Main navigation",
  fr: "Navigation principale",
  de: "Hauptnavigation",
  pt: "Navegação principal",
};

const servicesNav: Record<Locale, string> = {
  es: "Servicios",
  en: "Services",
  fr: "Services",
  de: "Dienste",
  pt: "Serviços",
};

const processNav: Record<Locale, string> = {
  es: "Cómo trabajamos",
  en: "Our process",
  fr: "Notre démarche",
  de: "Unser Ablauf",
  pt: "Como trabalhamos",
};

const ctaNav: Record<Locale, string> = {
  es: "Hablemos",
  en: "Let’s talk",
  fr: "Parlons-en",
  de: "Kontakt",
  pt: "Fale conosco",
};

const taglineTop: Record<Locale, string> = {
  es: "Pequeños comienzos. Grandes posibilidades.",
  en: "Small beginnings. Real possibilities.",
  fr: "Petits débuts. Grandes perspectives.",
  de: "Kleine Anfänge. Echte Möglichkeiten.",
  pt: "Pequenos começos. Grandes possibilidades.",
};

const privacyNav: Record<Locale, { path: string; label: string }> = {
  es: { path: "/politica-de-privacidad", label: "Política de privacidad" },
  en: { path: "/en/privacy-policy", label: "Privacy policy" },
  fr: { path: "/fr/politique-de-confidentialite", label: "Politique de confidentialité" },
  de: { path: "/de/datenschutzerklaerung", label: "Datenschutzerklärung" },
  pt: { path: "/pt/politica-de-privacidade", label: "Política de privacidade" },
};

const termsNav: Record<Locale, { path: string; label: string }> = {
  es: { path: "/condiciones-de-servicio", label: "Condiciones de servicio" },
  en: { path: "/en/terms-of-service", label: "Terms of service" },
  fr: { path: "/fr/conditions-de-service", label: "Conditions de service" },
  de: { path: "/de/nutzungsbedingungen", label: "Nutzungsbedingungen" },
  pt: { path: "/pt/termos-de-servico", label: "Termos de serviço" },
};

const taglineBottom: Record<Locale, string> = {
  es: "Tecnología con propósito. Hecha para tu negocio.",
  en: "Built with purpose. Made for your business.",
  fr: "De la technologie avec du sens. Conçue pour votre entreprise.",
  de: "Technologie mit Sinn. Für Ihr Unternehmen gemacht.",
  pt: "Tecnologia com propósito. Feita para o seu negócio.",
};
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2449e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        {supportedLocales.map((l) => (
          <link
            rel="alternate"
            hreflang={l}
            href={new URL(resolvedAlternates[l], siteUrl).href}
          />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(resolvedAlternates.es || "/", siteUrl).href}
        />
      </>
    )}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[currentLang]} />
    <meta property="og:image" content={new URL(image, siteUrl).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      defer
      src="https://stats.yunitztech.com/script.js"
      data-website-id="e0ea1d12-7f07-4fe9-9825-9afb0fbcde66"
      data-do-not-track="true"
    ></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      {skipTexts[currentLang]}
    </a>
    <header class="header">
      <div class="container nav">
        <a class="brand" href={home} aria-label={brandAria[currentLang]}>
          <span class="brand-mark" aria-hidden="true">
            y.
          </span>
          yunitz<span class="brand-light">tech</span>
        </a>
        <nav aria-label={navAria[currentLang]}>
          <a href={home + "#servicios"}>{servicesNav[currentLang]}</a>
          <a href={home + "#proceso"}>{processNav[currentLang]}</a>
          <a href={home + "blog"}>Blog</a>
        </nav>
        <div class="nav-actions">
          <details class="language-picker">
            <summary
              class="language"
              aria-label={langAriaLabels[currentLang]}
            >
              <span>{currentLang.toUpperCase()}</span>
              <span aria-hidden="true" class="lang-arrow">▾</span>
            </summary>
            <div class="language-dropdown">
              <div class="language-dropdown-header">
                {siteInLangHeader[currentLang]}
              </div>
              {displayLocales.map((l) => (
                <a
                  class={`language-option ${l === currentLang ? "active" : ""}`}
                  href={resolvedAlternates[l]}
                  lang={l}
                  hreflang={l}
                  aria-current={l === currentLang ? "true" : undefined}
                >
                  <span class="lang-flag-wrap">
                    {l === "es" && (
                      <svg class="lang-flag" viewBox="0 0 640 480" width="24" height="17" aria-hidden="true">
                        <rect width="640" height="120" fill="#aa151b" />
                        <rect y="120" width="640" height="240" fill="#f1bf00" />
                        <rect y="360" width="640" height="120" fill="#aa151b" />
                        <g transform="translate(130, 160) scale(0.65)">
                          <path d="M20,40 Q50,20 80,40 L75,55 L25,55 Z" fill="#aa151b" />
                          <circle cx="50" cy="20" r="5" fill="#f1bf00" />
                          <circle cx="20" cy="38" r="4" fill="#f1bf00" />
                          <circle cx="80" cy="38" r="4" fill="#f1bf00" />
                          <rect x="5" y="45" width="8" height="75" fill="#c4c9d4" rx="2" />
                          <rect x="87" y="45" width="8" height="75" fill="#c4c9d4" rx="2" />
                          <path d="M22,60 H78 V95 Q78,125 50,135 Q22,125 22,95 Z" fill="#aa151b" stroke="#aa151b" stroke-width="2" />
                          <path d="M25,62 H75 V95 Q75,122 50,132 Q25,122 25,95 Z" fill="#f1bf00" />
                          <path d="M25,62 H50 V97 H25 Z" fill="#aa151b" />
                          <path d="M50,97 H75 Q75,122 50,132 Z" fill="#aa151b" />
                        </g>
                      </svg>
                    )}
                    {l === "en" && (
                      <svg class="lang-flag" viewBox="0 0 640 480" width="24" height="17" aria-hidden="true">
                        <rect width="640" height="480" fill="#b22234" />
                        <path d="M0,36.92h640v36.92H0z M0,110.77h640v36.92H0z M0,184.62h640v36.92H0z M0,258.46h640v36.92H0z M0,332.31h640v36.92H0z M0,406.15h640v36.92H0z" fill="#ffffff" />
                        <rect width="256" height="258.46" fill="#3c3b6e" />
                        <g fill="#ffffff">
                          <circle cx="20" cy="30" r="7" />
                          <circle cx="60" cy="30" r="7" />
                          <circle cx="100" cy="30" r="7" />
                          <circle cx="140" cy="30" r="7" />
                          <circle cx="180" cy="30" r="7" />
                          <circle cx="220" cy="30" r="7" />
                          <circle cx="40" cy="80" r="7" />
                          <circle cx="80" cy="80" r="7" />
                          <circle cx="120" cy="80" r="7" />
                          <circle cx="160" cy="80" r="7" />
                          <circle cx="200" cy="80" r="7" />
                          <circle cx="20" cy="130" r="7" />
                          <circle cx="60" cy="130" r="7" />
                          <circle cx="100" cy="130" r="7" />
                          <circle cx="140" cy="130" r="7" />
                          <circle cx="180" cy="130" r="7" />
                          <circle cx="220" cy="130" r="7" />
                          <circle cx="40" cy="180" r="7" />
                          <circle cx="80" cy="180" r="7" />
                          <circle cx="120" cy="180" r="7" />
                          <circle cx="160" cy="180" r="7" />
                          <circle cx="200" cy="180" r="7" />
                          <circle cx="20" cy="230" r="7" />
                          <circle cx="60" cy="230" r="7" />
                          <circle cx="100" cy="230" r="7" />
                          <circle cx="140" cy="230" r="7" />
                          <circle cx="180" cy="230" r="7" />
                          <circle cx="220" cy="230" r="7" />
                        </g>
                      </svg>
                    )}
                    {l === "pt" && (
                      <svg class="lang-flag" viewBox="0 0 640 480" width="24" height="17" aria-hidden="true">
                        <rect width="640" height="480" fill="#009739" />
                        <polygon points="320,50 590,240 320,430 50,240" fill="#fedd00" />
                        <circle cx="320" cy="240" r="110" fill="#012169" />
                        <path d="M216,252 a110,110 0 0,0 208,-24 a116,116 0 0,1 -208,24" fill="#ffffff" />
                      </svg>
                    )}
                    {l === "de" && (
                      <svg class="lang-flag" viewBox="0 0 640 480" width="24" height="17" aria-hidden="true">
                        <rect width="640" height="160" fill="#000000" />
                        <rect y="160" width="640" height="160" fill="#dd0000" />
                        <rect y="320" width="640" height="160" fill="#ffce00" />
                      </svg>
                    )}
                    {l === "fr" && (
                      <svg class="lang-flag" viewBox="0 0 640 480" width="24" height="17" aria-hidden="true">
                        <rect width="213.3" height="480" fill="#002654" />
                        <rect x="213.3" width="213.4" height="480" fill="#ffffff" />
                        <rect x="426.7" width="213.3" height="480" fill="#ce1126" />
                      </svg>
                    )}
                  </span>
                  <span class="lang-name">{langNames[l]}</span>
                  {l === currentLang && (
                    <svg
                      class="lang-check"
                      aria-hidden="true"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </details>
          <a class="button small" href={home + "#contacto"}>
            {ctaNav[currentLang]} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="container footer-top">
        <div>
          <a class="brand" href={home}>
            <span class="brand-mark" aria-hidden="true">
              y.
            </span>
            yunitz<span class="brand-light">tech</span>
          </a>
          <p>{taglineTop[currentLang]}</p>
        </div>
        <div class="footer-links">
          <a href={home + "blog"}>Blog</a>
          <a href={privacyNav[currentLang].path}>
            {privacyNav[currentLang].label}
          </a>
          <a href={termsNav[currentLang].path}>
            {termsNav[currentLang].label}
          </a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} YunitzTech</span>
        <span>{taglineBottom[currentLang]}</span>
      </div>
    </footer>
    <script>
      if (
        /^\/(?:(?:en|fr|de|pt)\/)?(?:blog(?:\/[a-z0-9-]+)?\/?)?$/.test(location.pathname) &&
        navigator.doNotTrack !== "1" &&
        !(navigator as Navigator & { globalPrivacyControl?: boolean })
          .globalPrivacyControl
      ) {
        fetch("/api/view", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            path: location.pathname,
            referrer: document.referrer,
          }),
          keepalive: true,
        }).catch(() => {});
      }

      document.addEventListener("click", (e) => {
        const pickers = document.querySelectorAll<HTMLDetailsElement>(".language-picker[open]");
        for (const p of pickers) {
          if (!p.contains(e.target as Node)) {
            p.removeAttribute("open");
          }
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          const pickers = document.querySelectorAll<HTMLDetailsElement>(".language-picker[open]");
          for (const p of pickers) {
            p.removeAttribute("open");
          }
        }
      });
    </script>
  </body>
</html>
