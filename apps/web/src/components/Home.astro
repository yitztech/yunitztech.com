    placeholder: "¿O que você gostaria de resolver para os seus clientes?",
    consentPrefix: "Li a",
    privacyLink: "/pt/politica-de-privacidade",
    privacyLabel: "política de privacidade",
    consentSuffix: "e concordo em ser contatado sobre minha solicitação.",
    submitButton: "Enviar minha ideia",
  },
};

const hero = heroData[currentLang];
const heroFeatures = heroFeaturesData[currentLang];
const heroCards = heroCardsData[currentLang];
const focusStrip = focusStripData[currentLang];
const services = servicesHeading[currentLang];
const mvp = mvpData[currentLang];
const proc = processData[currentLang];
const blogSec = blogSectionData[currentLang];
const contact = contactData[currentLang];
const ctaReassurance = ctaReassuranceData[currentLang];
---

<Layout
  lang={currentLang}
  title={metaTitles[currentLang]}
  description={metaDescriptions[currentLang]}
  image={content?.image}
  alternate={currentLang === "en" ? "/" : "/en/"}
  alternates={alternates}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "YunitzTech",
      url: siteUrl,
      description: orgDescriptions[currentLang],
    }).replace(/</g, "\\u003c")}
  />
  {!content ? (
    <section class="container section">
      <h1>{emptyStates[currentLang].title}</h1>
      <p>{emptyStates[currentLang].desc}</p>
    </section>
  ) : (
    <>
      <section class="hero-shell relative overflow-hidden pt-4 pb-8 sm:pt-6 sm:pb-12 lg:pt-8 lg:pb-14">
        <!-- SVG ClipPath for organic photo curve on large screens -->
        <svg aria-hidden="true" class="pointer-events-none absolute size-0">
          <defs>
            <clipPath id="hero-photo-clip" clipPathUnits="objectBoundingBox">
              <path d="M0.03,0 C0.012,0 0,0.015 0,0.035 L0,0.56 C0.005,0.72 0.1,0.86 0.44,1 L1,1 L1,0 Z" />
            </clipPath>
          </defs>
        </svg>

        <div class="container hero items-center">
          <div class="hero-copy">
            <p class="inline-flex items-center gap-2 rounded-full bg-[#fbe5e5] px-3.5 py-1 text-xs font-semibold tracking-wider text-[#9c244b] uppercase">
              <span class="size-1.5 rounded-full bg-[#9c244b]"></span>
              {hero.eyebrow}
            </p>
            <h1 class="mt-4 font-display text-[2.5rem] leading-[1.04] font-extrabold tracking-[-0.04em] text-ink sm:text-[3.2rem] lg:text-[3.5rem]">
              {content.headline}
            </h1>
            <p class="lead mt-5 max-w-xl text-[15px] leading-relaxed text-ink-muted sm:text-base">
              {content.description}
            </p>
            <div class="hero-actions mt-7 flex flex-wrap items-center gap-3">
              <a class="button" href="#contacto">
                {hero.tellIdea}{" "}
                <span aria-hidden="true">↗</span>
              </a>
              <a class="button button-outline" href="#servicios">
                {hero.exploreServices}{" "}
                <span aria-hidden="true">↓</span>
              </a>
            </div>
            <p class="hero-note text-xs text-ink-muted/80 mt-4">{hero.note}</p>
            <ul class="hero-features-list mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3 list-none p-0">
              {heroFeatures.map((feat) => (
                <li class="flex items-center gap-2.5">
                  <span class="grid size-8 shrink-0 place-items-center rounded-full bg-[#fbe5e5] text-[#9c244b]" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                    </svg>
                  </span>
                  <div>
                    <strong class="block text-[11px] font-bold text-ink">{feat.title}</strong>
                    <span class="block text-[10px] leading-tight text-ink-muted">{feat.desc}</span>
                  </div>
                </li>
              ))}
            </ul>
          </div>
          <div class="hero-art relative">
            <div class="hero-photo-mask relative overflow-hidden rounded-3xl bg-[#feebda]">
              <img
                src={content.image}
                width="1200"
                height="800"
                alt={hero.imgAlt}
                fetchpriority="high"
                class="h-[360px] w-full object-cover sm:h-[430px]"
              />
            </div>
            <!-- Floating authentic value card top left -->
            <div class="art-card-stat absolute -top-4 -left-4 hidden rounded-2xl bg-white/95 p-3.5 shadow-float backdrop-blur-sm sm:flex items-center gap-3 ring-1 ring-black/[0.04]">
              <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-[#edeafb] text-[#6d5bd0]" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
                  <line x1="18" x2="18" y1="20" y2="10" />
                  <line x1="12" x2="12" y1="20" y2="4" />
                  <line x1="6" x2="6" y1="20" y2="14" />
                </svg>
              </span>
              <div>
                <p class="font-display text-sm font-bold text-ink">{heroCards.statTitle}</p>
                <p class="text-[10px] text-ink-muted">{heroCards.statDesc}</p>
              </div>
            </div>
            <!-- Floating checklist card top right -->
            <div class="art-card-checks absolute top-6 -right-4 hidden rounded-2xl bg-white/95 p-3.5 shadow-float backdrop-blur-sm lg:block ring-1 ring-black/[0.04]">
              <p class="text-[11px] font-bold tracking-wider text-ink/70 uppercase mb-2">{heroCards.checkTitle}</p>
              <ul class="space-y-1 text-[11px] font-medium text-ink/80 list-none p-0 m-0">
                {heroCards.checks.map((chk) => (
                  <li class="flex items-center gap-1.5">
                    <span class="grid size-4 place-items-center rounded-full bg-[#fbe5e5] text-[#9c244b] text-[10px]" aria-hidden="true">✓</span>
                    <span>{chk}</span>
                  </li>
                ))}
              </ul>
            </div>
            <!-- Note card bottom -->
            <div class="art-note absolute -bottom-5 left-6 rounded-2xl bg-white/95 p-3 shadow-float backdrop-blur-sm flex items-center gap-3 ring-1 ring-black/[0.04]">
              <span class="check grid size-8 place-content-center rounded-full bg-[#e8f4ec] text-[#2e6c47]" aria-hidden="true">
                ✓
              </span>
              <div>
                <strong class="text-xs font-bold text-ink">{hero.noteTitle}</strong>
                <span class="text-[10px] text-ink-muted">{hero.noteSubtitle}</span>
              </div>
            </div>
          </div>
        </div>
      </section>
      <div class="focus-strip border-y border-[#f1e7e1] bg-[#fffdfb] py-5">
        <div class="container flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-ink-muted">
          <span class="text-[11px] tracking-wider uppercase text-ink/60 font-bold">{focusStrip.label}</span>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            {focusStrip.items.map((item) => (
              <span class="inline-flex items-center gap-2 text-[13px] text-ink/80">
                <span class="size-1.5 rounded-full bg-[#9c244b]"></span>
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>
      <section class="services-section blush-wash py-16 sm:py-20" id="servicios">
        <div class="container section">
          <div class="section-heading mb-10 sm:mb-12">
            <div class="max-w-2xl">
              <p class="inline-flex items-center gap-2 rounded-full bg-[#fbe5e5] px-3.5 py-1 text-xs font-semibold tracking-wider text-[#9c244b] uppercase mb-3">
                {services.eyebrow}
              </p>
              <h2 class="font-display text-3xl font-extrabold tracking-[-0.03em] text-ink sm:text-4xl lg:text-[2.6rem]">
                <span class="block">{services.title.split('\n')[0]}</span>
                {services.title.split('\n')[1] && (
                  <span class="text-gradient-rose block">{services.title.split('\n')[1]}</span>
                )}
              </h2>
            </div>
            <p class="max-w-md text-sm leading-relaxed text-ink-muted">{services.desc}</p>
          </div>
          <div class="service-grid grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
            {content.services.map((s: any, i: number) => (
              <ServiceCard
                title={s.title}
                description={s.description}
                index={i}
                linkLabel={services.explore}
                ariaLabel={services.talkAbout + s.title}
              />
            ))}
          </div>
        </div>
      </section>
      <section class="mvp-section peach-wash py-16 sm:py-20">
        <div class="container mvp-layout">
          <div class="mvp-photo">
            <img
              src="/images/mvp-validation.webp"
              width="1200"
              height="800"
              alt={mvp.imgAlt}
              loading="lazy"
              decoding="async"
            />
            <span class="learn-label font-bold text-xs">{mvp.learnLabel}</span>
          </div>
          <div>
            <p class="inline-flex items-center gap-2 rounded-full bg-[#fbe5e5] px-3.5 py-1 text-xs font-semibold tracking-wider text-[#9c244b] uppercase mb-3">
              {mvp.eyebrow}
            </p>
            <h2 class="font-display text-3xl font-extrabold tracking-[-0.03em] text-ink sm:text-4xl">
              {mvp.title}
            </h2>
            <p class="lead mt-4 text-sm sm:text-base leading-relaxed text-ink-muted">{mvp.lead}</p>
            <ul class="check-list mt-6 space-y-2.5">
              {mvp.checks.map((chk) => (
                <li class="flex items-center gap-2.5 text-sm font-medium text-ink">
                  <span class="grid size-5 place-items-center rounded-full bg-[#fbe5e5] text-[#9c244b] text-xs">✓</span>
                  <span>{chk}</span>
                </li>
              ))}
            </ul>
            <a
              class="group mt-8 inline-flex items-center gap-2 text-sm font-bold text-plum transition-colors hover:text-ink"
              href={prefix + "/blog/" + mvp.articleSlug}
            >
              <span>{mvp.learnMore}</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">↗</span>
            </a>
          </div>
        </div>
      </section>
      <section class="container section py-16 sm:py-20" id="proceso">
        <div class="section-heading mb-12">
          <div class="max-w-2xl">
            <p class="inline-flex items-center gap-2 rounded-full bg-[#fbe5e5] px-3.5 py-1 text-xs font-semibold tracking-wider text-[#9c244b] uppercase mb-3">
              {proc.eyebrow}
            </p>
            <h2 class="font-display text-3xl font-extrabold tracking-[-0.03em] text-ink sm:text-4xl lg:text-[2.6rem]">
              <span class="block">{proc.title.split('\n')[0]}</span>
              {proc.title.split('\n')[1] && (
                <span class="block">{proc.title.split('\n')[1]}</span>
              )}
            </h2>
          </div>
          <p class="max-w-md text-sm leading-relaxed text-ink-muted">{proc.desc}</p>
        </div>
        <ol class="steps-grid grid gap-8 sm:grid-cols-2 lg:grid-cols-3 list-none p-0 m-0">
          {proc.steps.map(([title, desc], i) => (
            <li class="relative">
              <article class="flex flex-col h-full">
                <div class="flex items-center gap-4 mb-4">
                  <span class="grid size-14 place-items-center rounded-full bg-[#fbe4e4] text-[#9c244b] ring-8 ring-[#fefaf7]" aria-hidden="true">
                    {i === 0 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                      </svg>
                    )}
                    {i === 1 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6">
                        <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
                        <path d="M9 18h6" />
                        <path d="M10 22h4" />
                      </svg>
                    )}
                    {i === 2 && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6">
                        <path d="m12 15 2 2 4-4" />
                        <rect width="18" height="18" x="3" y="3" rx="2" />
                        <path d="M3 9h18" />
                      </svg>
                    )}
                  </span>
                  {i < proc.steps.length - 1 && (
                    <div class="hidden lg:flex items-center flex-1 pr-4" aria-hidden="true">
                      <span class="h-px flex-1 bg-[#e8c8cd]"></span>
                      <span class="text-[#d9aab4] -ml-1 text-xs">→</span>
                    </div>
                  )}
                </div>
                <p class="text-[11px] font-bold tracking-widest text-ink/40 uppercase">0{i + 1}</p>
                <h3 class="mt-1 font-display text-[1.15rem] font-bold tracking-[-0.015em] text-ink">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-muted">{desc}</p>
              </article>
            </li>
          ))}
        </ol>
      </section>
      <section class="blog-section peach-wash py-16 sm:py-20">
        <div class="container section">
          <div class="section-heading mb-10 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="inline-flex items-center gap-2 rounded-full bg-[#fbe5e5] px-3.5 py-1 text-xs font-semibold tracking-wider text-[#9c244b] uppercase mb-3">
                {blogSec.eyebrow}
              </p>
              <h2 class="font-display text-3xl font-extrabold tracking-[-0.03em] text-ink sm:text-4xl">
                <span class="block">{blogSec.title.split('\n')[0]}</span>
                {blogSec.title.split('\n')[1] && (
                  <span class="block">{blogSec.title.split('\n')[1]}</span>
                )}
              </h2>
            </div>
            <a class="group inline-flex items-center gap-2 text-sm font-bold text-ink transition-colors hover:text-plum" href={prefix + "/blog"}>
              {blogSec.allArticles}{" "}
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">↗</span>
            </a>
          </div>
          <div class="post-grid grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.slice(0, 3).map((p: any) => (
              <a
                class="group flex flex-col overflow-hidden rounded-2xl border border-white/80 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-soft"
                href={prefix + "/blog/" + p.slug}
              >
                <div class="relative h-48 w-full overflow-hidden">
                  <img
                    src={p.image}
                    width="600"
                    height="400"
                    alt={p.image_alt}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                  <span class="absolute top-3 left-3 rounded-full bg-plum/85 px-3 py-1 text-[11px] font-semibold text-white backdrop-blur-sm">
                    {blogSec.tag}
                  </span>
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="font-display text-lg font-bold tracking-tight text-ink group-hover:text-plum transition-colors">
                    {p.title}
                  </h3>
                  <p class="mt-2 text-[13px] leading-relaxed text-ink-muted line-clamp-2">
                    {p.excerpt}
                  </p>
                  <span class="mt-auto pt-4 inline-flex items-center gap-1.5 text-xs font-bold text-plum">
                    {blogSec.readArticle} <span aria-hidden="true">↗</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="container section py-16 sm:py-20" id="contacto">
        <div class="cta-mesh relative overflow-hidden rounded-[28px] p-6 sm:p-10 lg:p-14 text-white shadow-soft">
          <!-- Subtle organic curves background overlay -->
          <svg aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 1200 300" class="pointer-events-none absolute inset-0 h-full w-full opacity-30">
            <path d="M-50 320 C 180 220, 260 120, 520 90 S 900 140, 1250 -40" stroke="rgba(255,255,255,0.25)" stroke-width="1.2" fill="none" />
            <path d="M-80 380 C 160 280, 300 170, 620 130 S 980 170, 1300 -20" stroke="rgba(255,255,255,0.15)" stroke-width="1" fill="none" />
          </svg>

          <div class="relative z-10 grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:items-start">
            <div>
              <p class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3.5 py-1 text-xs font-semibold tracking-wider text-white/90 uppercase mb-3">
                {contact.eyebrow}
              </p>
              <h2 class="font-display text-3xl font-extrabold tracking-[-0.03em] text-white sm:text-4xl lg:text-[2.6rem] leading-[1.08]">
                <span class="block">{contact.title.split('\n')[0]}</span>
                {contact.title.split('\n')[1] && (
                  <span class="block">{contact.title.split('\n')[1]}</span>
                )}
              </h2>
              <p class="lead mt-4 text-sm sm:text-base leading-relaxed text-white/80">
                {contact.lead}
              </p>
              <div class="contact-note mt-6 flex items-start gap-3 rounded-xl bg-white/10 p-4 border border-white/15 text-xs text-white/85">
                <span aria-hidden="true" class="text-sm">↗</span>
                <p class="m-0 text-white/85">{contact.note}</p>
              </div>
              <p class="mt-4 text-xs text-white/70">
                {ctaReassurance}
              </p>
            </div>

            <form id="contact-form" class="contact-form rounded-2xl bg-white p-6 sm:p-8 text-ink shadow-float" method="post" data-lang={currentLang}>
              <div class="form-row grid gap-4 sm:grid-cols-2">
                <label class="block text-xs font-bold text-ink">
                  {contact.nameLabel}
                  <input
                    name="name"
                    autocomplete="name"
                    required
                    minlength="2"
                    maxlength="100"
                    class="mt-1.5 block w-full rounded-xl border border-[#ece3de] bg-[#fefaf7] px-3.5 py-2.5 text-sm text-ink outline-none transition focus:border-plum focus:ring-2 focus:ring-[#6d5bd0]/25"
                  />
                </label>
                <label class="block text-xs font-bold text-ink">
                  {contact.emailLabel}
                  <input
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                    maxlength="254"
                    class="mt-1.5 block w-full rounded-xl border border-[#ece3de] bg-[#fefaf7] px-3.5 py-2.5 text-sm text-ink outline-none transition focus:border-plum focus:ring-2 focus:ring-[#6d5bd0]/25"
                  />
                </label>
              </div>
              <label class="block mt-4 text-xs font-bold text-ink">
                {contact.companyLabel}
                <input
                  name="company"
                  autocomplete="organization"
                  maxlength="150"
                  class="mt-1.5 block w-full rounded-xl border border-[#ece3de] bg-[#fefaf7] px-3.5 py-2.5 text-sm text-ink outline-none transition focus:border-plum focus:ring-2 focus:ring-[#6d5bd0]/25"
                />
              </label>
              <label class="block mt-4 text-xs font-bold text-ink">
                {contact.serviceLabel}
                <select
                  name="service"
                  required
                  class="mt-1.5 block w-full rounded-xl border border-[#ece3de] bg-[#fefaf7] px-3.5 py-2.5 text-sm text-ink outline-none transition focus:border-plum focus:ring-2 focus:ring-[#6d5bd0]/25"
                >
                  <option value="">{contact.chooseService}</option>
                  {content.services.map((s: any) => (
                    <option>{s.title}</option>
                  ))}
                  <option>{contact.helpMvp}</option>
                </select>
              </label>
              <label class="block mt-4 text-xs font-bold text-ink">
                {contact.messageLabel}
                <textarea
                  name="message"
                  rows="4"
                  required
                  minlength="20"
                  maxlength="5000"
                  placeholder={contact.placeholder}
                  class="mt-1.5 block w-full rounded-xl border border-[#ece3de] bg-[#fefaf7] px-3.5 py-2.5 text-sm text-ink outline-none transition focus:border-plum focus:ring-2 focus:ring-[#6d5bd0]/25 resize-y"
                ></textarea>
              </label>
              <div class="honey hidden" aria-hidden="true" style="display:none">
                <label>
                  Website
                  <input name="website" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <label class="checkbox mt-4 flex items-start gap-2.5 text-xs text-ink-muted">
                <input type="checkbox" name="consent" required class="mt-0.5 rounded border-[#ece3de] text-plum focus:ring-[#6d5bd0]" />
                <span>
                  {contact.consentPrefix}{" "}
                  <a href={contact.privacyLink} class="font-bold text-plum underline underline-offset-2">
                    {contact.privacyLabel}
                  </a>{" "}
                  {contact.consentSuffix}
                </span>
              </label>
              <button class="button mt-5 w-full justify-center text-sm font-semibold shadow-[0_14px_30px_-16px_rgba(48,32,99,0.75)] hover:bg-plum-deep" type="submit">
                {contact.submitButton} ↗
              </button>
              <p id="form-status" role="status" aria-live="polite" class="mt-3 text-center text-xs font-medium"></p>
            </form>
          </div>
        </div>
      </section>
    </>
  )}
  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = form.querySelector("button")!;
      const status = document.querySelector("#form-status")!;
      const lang = form.dataset.lang || "es";
      
      const sendingMsg: Record<string, string> = {
        es: "Enviando…",
        en: "Sending…",
        fr: "Envoi en cours…",
        de: "Wird gesendet…",
        pt: "Enviando…",
      };
      const successMsg: Record<string, string> = {
        es: "Tu idea ya está en nuestra bandeja. Gracias por compartirla.",
        en: "Your idea is in our inbox. Thank you for telling us about it.",
        fr: "Votre idée est bien arrivée. Merci de l'avoir partagée avec nous.",
        de: "Ihre Idee ist eingegangen. Vielen Dank für Ihre Nachricht.",
        pt: "Sua ideia já está na nossa caixa de entrada. Obrigado por compartilhar.",
      };
      const errorMsg: Record<string, string> = {
        es: "No pudimos enviar tu solicitud. Revisa los campos e intenta nuevamente en unos minutos.",
        en: "We couldn’t send your request. Check the fields and try again shortly.",
        fr: "Impossible d'envoyer votre demande. Vérifiez les champs et réessayez dans quelques instants.",
        de: "Ihre Anfrage konnte nicht gesendet werden. Bitte Felder prüfen und kurz warten.",
        pt: "Não foi possível enviar sua solicitação. Verifique os campos e tente novamente em instantes.",
      };

      button.disabled = true;
      status.textContent = sendingMsg[lang] || sendingMsg.es;
      const values = Object.fromEntries(new FormData(form));
      try {
        const r = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            ...values,
            consent: values.consent === "on",
            locale: form.dataset.lang,
          }),
        });
        if (!r.ok) throw new Error();
        form.reset();
        status.textContent = successMsg[lang] || successMsg.es;
      } catch {
        status.textContent = errorMsg[lang] || errorMsg.es;
      } finally {
        button.disabled = false;
      }
    });
  </script>
</Layout>
