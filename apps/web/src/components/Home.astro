const focusStrip = focusStripData[currentLang];
const services = servicesHeading[currentLang];
const mvp = mvpData[currentLang];
const proc = processData[currentLang];
const blogSec = blogSectionData[currentLang];
const contact = contactData[currentLang];
---

<Layout
  lang={currentLang}
  title={metaTitles[currentLang]}
  description={metaDescriptions[currentLang]}
  image={content?.image}
  alternate={currentLang === "en" ? "/" : "/en/"}
  alternates={alternates}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "YunitzTech",
      url: siteUrl,
      description: orgDescriptions[currentLang],
    }).replace(/</g, "\\u003c")}
  />
  {!content ? (
    <section class="container section">
      <h1>{emptyStates[currentLang].title}</h1>
      <p>{emptyStates[currentLang].desc}</p>
    </section>
  ) : (
    <>
      <section class="hero container">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="status-dot"></span>
            {hero.eyebrow}
          </p>
          <h1>{content.headline}</h1>
          <p class="lead">{content.description}</p>
          <div class="hero-actions">
            <a class="button" href="#contacto">
              {hero.tellIdea}{" "}
              <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#servicios">
              {hero.exploreServices}{" "}
              <span aria-hidden="true">↓</span>
            </a>
          </div>
          <p class="hero-note">{hero.note}</p>
        </div>
        <div class="hero-art">
          <div class="art-caption">
            <span class="tiny-icon" aria-hidden="true">
              ✦
            </span>
            {hero.caption}
          </div>
          <img
            src={content.image}
            width="1200"
            height="800"
            alt={hero.imgAlt}
            fetchpriority="high"
          />
          <div class="art-note">
            <span class="check" aria-hidden="true">
              ✓
            </span>
            <div>
              <strong>{hero.noteTitle}</strong>
              <span>{hero.noteSubtitle}</span>
            </div>
          </div>
        </div>
      </section>
      <div class="focus-strip">
        <div class="container">
          <span>{focusStrip.label}</span>
          <div>
            {focusStrip.items.map((item, idx) => (
              <>
                {item}
                {idx < focusStrip.items.length - 1 && <i>✳</i>}
              </>
            ))}
          </div>
        </div>
      </div>
      <section class="container section services" id="servicios">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{services.eyebrow}</p>
            <h2>{services.title}</h2>
          </div>
          <p>{services.desc}</p>
        </div>
        <div class="service-grid">
          {content.services.map((s: any, i: number) => (
            <article class="service-card">
              <span class="service-icon" aria-hidden="true">
                {["↗", "▦", "◷", "▣", "✉", "⌘"][i % 6]}
              </span>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
              <a
                href="#contacto"
                aria-label={services.talkAbout + s.title}
              >
                {services.explore}{" "}
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>
      <section class="mvp-section">
        <div class="container mvp-layout">
          <div class="mvp-photo">
            <img
              src="/images/mvp-validation.webp"
              width="1200"
              height="800"
              alt={mvp.imgAlt}
              loading="lazy"
              decoding="async"
            />
            <span class="learn-label">{mvp.learnLabel}</span>
          </div>
          <div>
            <p class="eyebrow">{mvp.eyebrow}</p>
            <h2>{mvp.title}</h2>
            <p class="lead">{mvp.lead}</p>
            <ul class="check-list">
              {mvp.checks.map((chk) => (
                <li>{chk}</li>
              ))}
            </ul>
            <a
              class="text-link"
              href={prefix + "/blog/" + mvp.articleSlug}
            >
              {mvp.learnMore} ↗
            </a>
          </div>
        </div>
      </section>
      <section class="container section" id="proceso">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{proc.eyebrow}</p>
            <h2>{proc.title}</h2>
          </div>
          <p>{proc.desc}</p>
        </div>
        <div class="steps">
          {proc.steps.map(([title, desc], i) => (
            <article>
              <span class="step-number">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{desc}</p>
            </article>
          ))}
        </div>
      </section>
      <section class="blog-section">
        <div class="container section">
          <div class="section-heading">
            <div>
              <p class="eyebrow">{blogSec.eyebrow}</p>
              <h2>{blogSec.title}</h2>
            </div>
            <a class="text-link" href={prefix + "/blog"}>
              {blogSec.allArticles} ↗
            </a>
          </div>
          <div class="post-grid">
            {posts.slice(0, 3).map((p: any, i: number) => (
              <a
                class={"post-card tone-" + i}
                href={prefix + "/blog/" + p.slug}
              >
                <div class="post-image">
                  <img
                    src={p.image}
                    width="600"
                    height="400"
                    alt={p.image_alt}
                    loading="lazy"
                  />
                  <span>{blogSec.tag}</span>
                </div>
                <div class="post-copy">
                  <h3>{p.title}</h3>
                  <p>{p.excerpt}</p>
                  <span class="text-link">
                    {blogSec.readArticle} ↗
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
      <section class="container section contact-layout" id="contacto">
        <div>
          <p class="eyebrow">{contact.eyebrow}</p>
          <h2>{contact.title}</h2>
          <p class="lead">{contact.lead}</p>
          <div class="contact-note">
            <span aria-hidden="true">↗</span>
            <p>{contact.note}</p>
          </div>
        </div>
        <form id="contact-form" class="contact-form" method="post" data-lang={currentLang}>
          <div class="form-row">
            <label>
              {contact.nameLabel}
              <input
                name="name"
                autocomplete="name"
                required
                minlength="2"
                maxlength="100"
              />
            </label>
            <label>
              {contact.emailLabel}
              <input
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
              />
            </label>
          </div>
          <label>
            {contact.companyLabel}
            <input name="company" autocomplete="organization" maxlength="150" />
          </label>
          <label>
            {contact.serviceLabel}
            <select name="service" required>
              <option value="">{contact.chooseService}</option>
              {content.services.map((s: any) => (
                <option>{s.title}</option>
              ))}
              <option>{contact.helpMvp}</option>
            </select>
          </label>
          <label>
            {contact.messageLabel}
            <textarea
              name="message"
              rows="4"
              required
              minlength="20"
              maxlength="5000"
              placeholder={contact.placeholder}
            ></textarea>
          </label>
          <div class="honey" aria-hidden="true">
            <label>
              Website
              <input name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <label class="checkbox">
            <input type="checkbox" name="consent" required />
            <span>
              {contact.consentPrefix}{" "}
              <a href={contact.privacyLink}>
                {contact.privacyLabel}
              </a>{" "}
              {contact.consentSuffix}
            </span>
          </label>
          <button class="button" type="submit">
            {contact.submitButton} ↗
          </button>
          <p id="form-status" role="status" aria-live="polite"></p>
        </form>
      </section>
    </>
  )}
  <script>
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const button = form.querySelector("button")!;
      const status = document.querySelector("#form-status")!;
      const lang = form.dataset.lang || "es";
      
      const sendingMsg: Record<string, string> = {
        es: "Enviando…",
        en: "Sending…",
        fr: "Envoi en cours…",
        de: "Wird gesendet…",
        pt: "Enviando…",
      };
      const successMsg: Record<string, string> = {
        es: "Tu idea ya está en nuestra bandeja. Gracias por compartirla.",
        en: "Your idea is in our inbox. Thank you for telling us about it.",
        fr: "Votre idée est bien arrivée. Merci de l'avoir partagée avec nous.",
        de: "Ihre Idee ist eingegangen. Vielen Dank für Ihre Nachricht.",
        pt: "Sua ideia já está na nossa caixa de entrada. Obrigado por compartilhar.",
      };
      const errorMsg: Record<string, string> = {
        es: "No pudimos enviar tu solicitud. Revisa los campos e intenta nuevamente en unos minutos.",
        en: "We couldn’t send your request. Check the fields and try again shortly.",
        fr: "Impossible d'envoyer votre demande. Vérifiez les champs et réessayez dans quelques instants.",
        de: "Ihre Anfrage konnte nicht gesendet werden. Bitte Felder prüfen und kurz warten.",
        pt: "Não foi possível enviar sua solicitação. Verifique os campos e tente novamente em instantes.",
      };

      button.disabled = true;
      status.textContent = sendingMsg[lang] || sendingMsg.es;
      const values = Object.fromEntries(new FormData(form));
      try {
        const r = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            ...values,
            consent: values.consent === "on",
            locale: form.dataset.lang,
          }),
        });
        if (!r.ok) throw new Error();
        form.reset();
        status.textContent = successMsg[lang] || successMsg.es;
      } catch {
        status.textContent = errorMsg[lang] || errorMsg.es;
      } finally {
        button.disabled = false;
      }
    });
  </script>
</Layout>
