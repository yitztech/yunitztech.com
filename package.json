{
  "name": "yunitztech",
  "version": "1.0.0",
  "description": "Company site",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\" tests/*.test.mjs",
    "test:db": "bash scripts/test-db.sh",
    "test:api": "bddgen && playwright test --project=api",
    "test:web": "bddgen && playwright test --project=web",
    "test:smoke": "playwright test --project=smoke",
    "test:e2e": "bddgen && playwright test",
    "test:ci": "npm run test:unit && npm run test:e2e",
    "test:all": "npm run test:unit && npm run test:db && npm run test:e2e",
    "build": "npm run build --workspaces",
    "check": "npm run build && npm run check -w apps/web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yitztech/yunitztech.com.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/yitztech/yunitztech.com/issues"
  },
  "homepage": "https://github.com/yitztech/yunitztech.com#readme",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@vercel/nft": "^1.11.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
